# Fireworks AI API key (required for embeddings and completions)
# Get one at https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=fw_your_api_key_here

# PostgreSQL connection settings for the demo database
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=demo_bank
